# ============================================================
# drawing-poc 环境变量配置（复制为 .env 后修改）
# cp .env.example .env
# ============================================================

# ── 服务器信息 ──────────────────────────────────
SERVER_IP=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
FRONTEND_LEGACY_PORT=8502
# React 以 /drawing-review 部署时设置为 /drawing-review；默认独立部署为 /
VITE_APP_BASE=/

# ── MySQL 数据库（现有，不需改动）────────────────
MYSQL_HOST=YOUR_MYSQL_HOST
MYSQL_PORT=YOUR_MYSQL_PORT
MYSQL_DB=YOUR_MYSQL_DATABASE
MYSQL_USER=YOUR_MYSQL_USER
MYSQL_PASSWORD=REPLACE_WITH_SECRET

# 留空时仅允许 Nginx 同源访问；如需跨域，填写受控的逗号分隔来源。
CORS_ORIGINS=

# ── PaddlePaddle 模型目录（容器内路径，勿改）────
PADDLE_MODELS_ROOT=/app/models/paddle

# ── 后端临时文件目录（容器内路径，勿改）────────
BACKEND_TMP_DIR=/app/project/drawing-standard-poc/backend/tmp

# ── MinerU 管口表修正 ──────────────────────────
# 本地确定性规则默认启用，不发送文档到外部服务。
NOZZLE_CORRECTION_ENABLED=true

# 仅歧义行需要内部 OpenAI-compatible Qwen；默认关闭，确认客户内网端点后再启用。
LLM_CORRECTION_ENABLED=false
LLM_BASE_URL=http://YOUR_INTERNAL_QWEN_ENDPOINT/v1
LLM_API_KEY=REPLACE_WITH_SECRET
LLM_MODEL=/models/YOUR_QWEN_MODEL
# qwen-vllm / dashscope / generic
LLM_PROVIDER=qwen-vllm
LLM_DISABLE_THINKING=true
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0
LLM_MAX_ROWS_PER_REQUEST=20

# ── uvicorn 配置 ────────────────────────────────
UVICORN_RELOAD=false
UVICORN_PORT=8000

# ── 日志目录（容器内路径，勿改）────────────────
LOG_DIR=/app/logs
