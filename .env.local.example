# Local CPU stack only. These values never target the customer environment.
LOCAL_BACKEND_PORT=8000
LOCAL_FRONTEND_PORT=8501
LOCAL_MYSQL_PORT=3307

# Local-only credentials for the isolated Docker volume or native Windows MySQL.
LOCAL_MYSQL_DATABASE=drawing_poc
LOCAL_MYSQL_USER=drawing_poc
LOCAL_MYSQL_PASSWORD=drawing_local_dev
LOCAL_MYSQL_ROOT_PASSWORD=drawing_local_root_dev

# ModelScope is normally faster from mainland China. Supported alternative: huggingface.
MINERU_DOWNLOAD_SOURCE=modelscope
